# Optional overrides. Defaults are https://aventrexdigital.com and voilit-ai.
AVENTREX_API_URL=https://aventrexdigital.com
NEXT_PUBLIC_AVENTREX_API_URL=https://aventrexdigital.com
AVENTREX_PRODUCT_SLUG=voilit-ai

# Voilit backend — public plans from the admin portal (/admin/plans)
VOILIT_API_URL=https://api.voilitai.com/
NEXT_PUBLIC_VOILIT_API_URL=https://api.voilitai.com/

# Must match Aventrex VOILIT_REVALIDATE_SECRET and backend MARKETING_REVALIDATE_SECRET.
# Aventrex VOILIT_REVALIDATE_URL / backend MARKETING_REVALIDATE_URL should be
# https://voilitai.com/api/revalidate
REVALIDATE_SECRET=
